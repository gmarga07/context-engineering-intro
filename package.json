{
  "name": "context-engineering-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Context Engineering workflow (generate PRP, execute PRP) via Model Context Protocol.",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "context-engineering-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/server.ts",
    "start": "node dist/server.js"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "context engineering",
    "prp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^20.11.17"
  }
}